# ---- PortalPilot configuration ----

# Portaldot endpoint used by default (reads, fee preview, dry-run).
PORTALDOT_WS=wss://mainnet.portaldot.io

# Backend port
PORT=8787

# Server-side demo signer. Defaults to //Alice (funded on a local --dev node).
# For real mainnet writes, set a funded account's mnemonic/URI here.
PORTALDOT_SIGNER_SEED=//Alice

# OPTIONAL: enable free-form natural language understanding via Claude.
# If unset, PortalPilot uses its built-in deterministic parser (no API key required).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
